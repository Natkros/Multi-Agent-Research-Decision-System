# Copy to .env for `docker compose up`. Every value below is optional and
# defaults to the fully-offline `local`/`local` providers — `docker compose
# up` works with zero API keys, same "no key required" design goal every
# backend phase followed (see backend/.env.example for the full variable
# reference; this file only covers what compose itself needs to inject).

# -- App --
ENVIRONMENT=development

# -- LLM / search providers: openai | anthropic | local, tavily | local --
LLM_PROVIDER=local
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SEARCH_PROVIDER=local
TAVILY_API_KEY=

# -- Auth. MUST be overridden (long random value) for ENVIRONMENT=production
# -- the app refuses to start in production with this default (see
# backend/app/config/settings.py). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me

# -- Postgres (backend + compose healthcheck use the same credentials) --
POSTGRES_USER=research
POSTGRES_PASSWORD=research
POSTGRES_DB=research

# -- Frontend build-time API origin (baked into the browser bundle) --
NEXT_PUBLIC_API_URL=http://localhost:8000

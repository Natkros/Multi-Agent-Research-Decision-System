# Copy to .env and fill in for local dev. None of these are required to run
# the app or test suite — the default providers (`local`/`local`) work fully
# offline with no keys.

# -- App -- ENVIRONMENT=production hard-fails at startup (Phase 10,
# app/config/settings.py:check_production_safe) unless JWT_SECRET_KEY is a
# real random value (>=32 chars, not this file's default), DATABASE_URL
# points at a real Postgres instance, and CORS_ALLOW_ORIGINS has no "*" —
# dev/test/staging are unaffected.
ENVIRONMENT=dev

# -- LLM provider: openai | anthropic | local --
LLM_PROVIDER=local
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model routing tiers (docs/architecture.md §6) — never hardcoded in agent code.
MODEL_SMALL=gpt-4o-mini
MODEL_MID=gpt-4o
MODEL_STRONG=gpt-4o
ANTHROPIC_MODEL_SMALL=claude-haiku-4-5
ANTHROPIC_MODEL_MID=claude-sonnet-4-5
ANTHROPIC_MODEL_STRONG=claude-opus-4-1

# -- Search provider: tavily | local --
SEARCH_PROVIDER=local
TAVILY_API_KEY=

# -- Database (Phase 3). Leave unset for a local in-memory sqlite database
# (via aiosqlite) — the app and test suite work fully offline with no live
# Postgres. Point this at a real Postgres instance for production:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/research
DATABASE_URL=

# -- Source Evaluator weighted scoring formula (docs/architecture.md §5.5):
# authority*0.25 + relevance*0.25 + recency*0.15 + specificity*0.20 +
# independence*0.15 by default. Override any single weight below (each
# must stay in [0, 1]; they are not auto-normalized to sum to 1). --
SOURCE_WEIGHT_AUTHORITY=0.25
SOURCE_WEIGHT_RELEVANCE=0.25
SOURCE_WEIGHT_RECENCY=0.15
SOURCE_WEIGHT_SPECIFICITY=0.20
SOURCE_WEIGHT_INDEPENDENCE=0.15

# -- Verification Gate: hard cap on correction cycles, enforced in code
# (app/orchestration/graph.py), not just described in a prompt. --
VERIFICATION_MAX_CYCLES=3

# -- Advocate/Critic debate pass (Phase 4): one advocate + one critic LLM
# call per run. DEBATE_MAX_ALTERNATIVES caps how many alternatives the
# single advocate call argues for, keeping the pass bounded. --
DEBATE_MAX_ALTERNATIVES=5
DEBATE_ADVOCATE_MAX_TOKENS=2500
DEBATE_CRITIC_MAX_TOKENS=2500

# -- Risk Analyst (Phase 4): below this many EvidenceItems, coverage is
# "thin" and an `unknown`-category risk is always included. --
RISK_THIN_EVIDENCE_THRESHOLD=3

# -- Decision Analyst sensitivity analysis (Phase 4): fraction each
# criterion's weight is perturbed by (both directions) to test whether the
# recommended alternative flips. --
SENSITIVITY_WEIGHT_PERTURBATION=0.20

# -- RAG pipeline (Phase 5): embeddings, Qdrant, chunking, hybrid retrieval,
# reranking. Defaults (`local` embeddings, no QDRANT_URL, `lexical_recency`
# reranker) work fully offline with no keys, no model download and no
# running Qdrant instance, same design goal every earlier phase followed. --
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Point at a running Qdrant instance to use it instead of the in-memory
# vector store fake; leave unset for local dev/tests.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=document_chunks

CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Hybrid retrieval merge weight: 0 = pure keyword (BM25), 1 = pure semantic.
HYBRID_RETRIEVAL_ALPHA=0.5

# Reranker: lexical_recency (default, no second model) | cross_encoder (real
# sentence-transformers CrossEncoder, opt-in — see
# app/retrieval/reranking.py for the tradeoff).
RERANKER=lexical_recency
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_RECENCY_WEIGHT=0.1

# -- Misc --
REQUEST_TIMEOUT_SECONDS=30
MAX_SEARCH_RESULTS=5

# -- Redis caching (Phase 6, docs/architecture.md §6/§16): result cache +
# semantic cache in front of the Researcher's search+retrieval step. Leave
# REDIS_URL unset for an in-memory fake (`LocalCacheService`) — the app and
# test suite work fully offline with no running Redis, same fallback
# pattern every other external-service seam in this codebase uses. --
REDIS_URL=
CACHE_RESULT_TTL_SECONDS=3600
CACHE_SEMANTIC_TTL_SECONDS=3600
CACHE_SEMANTIC_SIMILARITY_THRESHOLD=0.92

# -- Background job runner (Phase 6): bounded-concurrency asyncio worker
# pool over a Postgres-backed `jobs` table (see app/services/job_runner.py
# for why Celery was skipped for now). --
JOB_RUNNER_CONCURRENCY=4

# -- Resilience (Phase 6, brief §26): retry/circuit-breaker knobs applied
# only to real external providers (OpenAI/Anthropic/Tavily/
# sentence-transformers/Qdrant), never the Local*/in-memory fakes. --
RESILIENCE_MAX_ATTEMPTS=3
RESILIENCE_BASE_DELAY_SECONDS=0.5
RESILIENCE_MAX_DELAY_SECONDS=8
RESILIENCE_CIRCUIT_FAILURE_THRESHOLD=5
RESILIENCE_CIRCUIT_RESET_SECONDS=30

# -- Observability (Phase 6, brief §15): OTel exporter selection. `console`
# (default) needs no extra infra; `otlp` sends spans to a real collector. --
OTEL_EXPORTER=console
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# -- Auth (Phase 8, docs/api.md "Auth & rate limiting"). JWT_SECRET_KEY has a
# dev-only default (see app/config/settings.py) so the app/test suite work
# offline with no secrets configured -- a real deployment MUST override this
# with a long random value and MUST NEVER commit the real value here.
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# -- Rate limiting (Phase 8): per-user token bucket on POST /api/v1/research,
# via the same Redis client REDIS_URL already configures above (no second
# Redis dependency) -- falls back to an in-memory limiter when unset. --
RATE_LIMIT_RESEARCH_CAPACITY=5
RATE_LIMIT_RESEARCH_REFILL_PER_MINUTE=5
